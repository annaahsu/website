---
import ButtonBar from "@components/buttonbar.astro";
import { Icon } from "astro-icon/components";
---

<ButtonBar>
  <a class="icon" href="mailto:hello@annahsu.dev">
    <Icon size={40} name="ion:mail" />
  </a>
  <a class="icon" href="https://anna.show/li" target="_blank">
    <Icon size={40} name="ion:logo-linkedin" />
  </a>
  <a class="icon" href="https://anna.show/tw" target="_blank">
    <Icon size={40} name="ion:logo-twitter" />
  </a>
  <a class="icon" href="https://anna.show/gh" target="_blank">
    <Icon size={40} name="ion:logo-github" />
  </a>
</ButtonBar>

<style lang="scss">
  [data-icon] {
    color: var(--med);
  }

  .icon {
    text-decoration: none;
  }

  a {
    box-shadow: none;
    padding: 0;
    transition: none;
  }
  a:hover {
    background: none;
  }
</style>
